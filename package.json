{
  "name": "@hebcal/rest-api",
  "version": "6.5.1",
  "author": "Michael J. Radwin (https://github.com/mjradwin)",
  "keywords": [
    "hebcal"
  ],
  "description": "Jewish holidays and Hebrew calendar as plain JSON objects and CSV export",
  "engines": {
    "node": ">= 18.0.0"
  },
  "module": "./dist/esm/index.js",
  "typings": "dist/esm/index.d.ts",
  "type": "module",
  "exports": {
    ".": "./dist/esm/index.js",
    "./dist/esm/*": "./dist/esm/*.js"
  },
  "files": [
    "dist",
    "po"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hebcal/hebcal-rest-api.git"
  },
  "bugs": {
    "url": "https://github.com/hebcal/hebcal-rest-api/issues"
  },
  "homepage": "https://hebcal.github.io/api/rest-api/",
  "dependencies": {
    "@hebcal/core": "^6.8.2",
    "@hebcal/hdate": "^0.22.5",
    "@hebcal/leyning": "^9.5.6"
  },
  "scripts": {
    "po2json": "node ./po2json.js po/en.po po/he.po",
    "build": "npm run po2json && rollup -c",
    "prepublish": "npm run build",
    "pretest": "npm run build",
    "docs": "typedoc",
    "lint": "oxlint && prettier --check \"src/**/*.ts\" \"*.{js,cjs}\"",
    "clean": "rm -rf ./dist",
    "fix": "oxlint --fix && prettier --write \"src/**/*.ts\" \"*.{js,cjs}\"",
    "test": "vitest"
  },
  "license": "BSD-2-Clause",
  "devDependencies": {
    "@hebcal/learning": "^6.9.5",
    "@hebcal/locales": "^6.5.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26.1.1",
    "gettext-parser": "^9.1.1",
    "oxlint": "^1.74.0",
    "prettier": "^3.9.6",
    "rollup": "^4.62.2",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.20",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
