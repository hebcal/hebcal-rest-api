msgid "MEMO:Asara B'Tevet"
msgstr "צום המציין את המצור על ירושלים"

msgid "MEMO:Ben-Gurion Day"
msgstr "יום המציין את חייו וחזונו של ראש הממשלה הראשון של ישראל, דוד בן-גוריון"

msgid "MEMO:Birkat Hachamah"
msgstr "ברכה יהודית נדירה הנאמרת אחת ל-28 שנים כהודיה לאל על בריאת החמה"

msgid "MEMO:Chag HaBanot"
msgstr "חג הבנות של חנוכה (עיד אל-בנאת), שמקורו ביהדות צפון אפריקה ונשתמר בעיקר בתוניסיה"

msgid "MEMO:Chanukah"
msgstr "חנוכה, חג החנוכה מחדש היהודי. ידוע גם כחג האורים; החג נחגג במשך שמונה ימים על ידי הדלקת נרות בחנוכייה"

msgid "MEMO:Days of the Omer"
msgstr "7 שבועות מהלילה השני של פסח ועד ליום לפני שבועות. נקרא גם ספירת העומר; מנהג הכולל ספירה מילולית של כל אחד מארבעים ותשעה הימים בין שני החגים"

msgid "MEMO:Erev Yom Kippur"
msgstr "ערב יום הכיפורים, הכולל את תפילת כל נדרי. צום יום הכיפורים מתחיל עם שקיעת החמה ונמשך 25 שעות"

msgid "MEMO:Family Day"
msgstr "יום המשפחה, יום להוקרת התא המשפחתי"

msgid "MEMO:Hebrew Language Day"
msgstr "יום לקידום השפה העברית בישראל וברחבי העולם. חל ביום הולדתו של אליעזר בן יהודה, מחייה השפה העברית"

msgid "MEMO:Herzl Day"
msgstr "יום המציין את חייו וחזונו של המנהיג הציוני בנימין זאב הרצל"

msgid "MEMO:Jabotinsky Day"
msgstr "יום המציין את חייו וחזונו של המנהיג הציוני זאב ז'בוטינסקי"

msgid "MEMO:Lag BaOmer"
msgstr "היום ה-33 לספירת העומר. החג מהווה הפוגה זמנית ממנהגי האבלות של תקופת ספירת העומר. המנהגים כוללים הדלקת מדורות, תספורות וחתונות"

msgid "MEMO:Leil Selichot"
msgstr "תפילות סליחה כהכנה לימים הנוראים"

msgid "MEMO:Pesach Sheni"
msgstr "פסח שני, חודש לאחר חג הפסח"

msgid "MEMO:Pesach"
msgstr "פסח, חג המצות. מציין את יציאת מצרים ושחרור בני ישראל ממצרים העתיקה"

msgid "MEMO:Purim Katan"
msgstr "חגיגת פורים קטן המצוינת במהלך חודש אדר א' בשנים מעוברות"

msgid "MEMO:Purim"
msgstr "חגיגת ההצלה היהודית כפי שמסופר במגילת אסתר. מציין תקופה שבה העם היהודי שחי בפרס ניצל מהשמדה"

msgid "MEMO:Purim Meshulash"
msgstr "פורים משולש, הנפרש על פני 3 ימים בירושלים ובערים מוקפות חומה. חל כאשר ט״ו באדר נופל בשבת"

msgid "MEMO:Rosh Chodesh Nisan"
msgstr "תחילת חודש ניסן בלוח העברי. ניסן הוא החודש ה-7 בשנה העברית האזרחית (ה-8 בשנים מעוברות) והחודש ה-1 בשנה העברית המקראית. יש בו 30 ימים והוא מקביל למרץ או אפריל בלוח הגרגוריאני. ראש חודש הוא מועד המצוין בתחילת כל חודש בלוח העברי ומסומן על ידי מולד הלבנה"

msgid "MEMO:Rosh Chodesh Iyyar"
msgstr "תחילת חודש אייר בלוח העברי. אייר הוא החודש ה-8 בשנה העברית האזרחית (ה-9 בשנים מעוברות) והחודש ה-2 בשנה העברית המקראית. יש בו 29 ימים והוא מקביל לאפריל או מאי בלוח הגרגוריאני. ראש חודש הוא מועד המצוין בתחילת כל חודש בלוח העברי ומסומן על ידי מולד הלבנה"

msgid "MEMO:Rosh Chodesh Sivan"
msgstr "תחילת חודש סיוון בלוח העברי. סיוון הוא החודש ה-9 בשנה העברית האזרחית (ה-10 בשנים מעוברות) והחודש ה-3 בשנה העברית המקראית. יש בו 30 ימים והוא מקביל למאי או יוני בלוח הגרגוריאני. ראש חודש הוא מועד המצוין בתחילת כל חודש בלוח העברי ומסומן על ידי מולד הלבנה"

msgid "MEMO:Rosh Chodesh Tamuz"
msgstr "תחילת חודש תמוז בלוח העברי. תמוז הוא החודש ה-10 בשנה העברית האזרחית (ה-11 בשנים מעוברות) והחודש ה-4 בשנה העברית המקראית. יש בו 29 ימים והוא מקביל ליוני או יולי בלוח הגרגוריאני. ראש חודש הוא מועד המצוין בתחילת כל חודש בלוח העברי ומסומן על ידי מולד הלבנה"

msgid "MEMO:Rosh Chodesh Av"
msgstr "תחילת חודש אב בלוח העברי. אב הוא החודש ה-11 בשנה העברית האזרחית (ה-12 בשנים מעוברות) והחודש ה-5 בשנה העברית המקראית. יש בו 30 ימים והוא מקביל ליולי או אוגוסט בלוח הגרגוריאני. ראש חודש הוא מועד המצוין בתחילת כל חודש בלוח העברי ומסומן על ידי מולד הלבנה"

msgid "MEMO:Rosh Chodesh Elul"
msgstr "תחילת חודש אלול בלוח העברי. אלול הוא החודש ה-12 בשנה העברית האזרחית (ה-13 בשנים מעוברות) והחודש ה-6 בשנה העברית המקראית. יש בו 29 ימים והוא מקביל לאוגוסט או ספטמבר בלוח הגרגוריאני. ראש חודש הוא מועד המצוין בתחילת כל חודש בלוח העברי ומסומן על ידי מולד הלבנה"

msgid "MEMO:Rosh Chodesh Cheshvan"
msgstr "תחילת חודש חשוון בלוח העברי. חשוון הוא החודש ה-2 בשנה העברית האזרחית והחודש ה-8 בשנה העברית המקראית. יש בו 29 או 30 ימים והוא מקביל לאוקטובר או נובמבר בלוח הגרגוריאני. ראש חודש הוא מועד המצוין בתחילת כל חודש בלוח העברי ומסומן על ידי מולד הלבנה"

msgid "MEMO:Rosh Chodesh Kislev"
msgstr "תחילת חודש כסלו בלוח העברי. כסלו הוא החודש ה-3 בשנה העברית האזרחית והחודש ה-9 בשנה העברית המקראית. יש בו 30 או 29 ימים והוא מקביל לנובמבר או דצמבר בלוח הגרגוריאני. ראש חודש הוא מועד המצוין בתחילת כל חודש בלוח העברי ומסומן על ידי מולד הלבנה"

msgid "MEMO:Rosh Chodesh Tevet"
msgstr "תחילת חודש טבת בלוח העברי. טבת הוא החודש ה-4 בשנה העברית האזרחית והחודש ה-10 בשנה העברית המקראית. יש בו 29 ימים והוא מקביל לדצמבר או ינואר בלוח הגרגוריאני. ראש חודש הוא מועד המצוין בתחילת כל חודש בלוח העברי ומסומן על ידי מולד הלבנה"

msgid "MEMO:Rosh Chodesh Sh'vat"
msgstr "תחילת חודש שבט בלוח העברי. שבט הוא החודש ה-5 בשנה העברית האזרחית והחודש ה-11 בשנה העברית המקראית. יש בו 30 ימים והוא מקביל לינואר או פברואר בלוח הגרגוריאני. ראש חודש הוא מועד המצוין בתחילת כל חודש בלוח העברי ומסומן על ידי מולד הלבנה"

msgid "MEMO:Rosh Chodesh Adar"
msgstr "תחילת חודש אדר בלוח העברי. אדר הוא החודש ה-6 בשנה העברית האזרחית והחודש ה-12 בשנה העברית המקראית. יש בו 29 ימים והוא מקביל לפברואר או מרץ בלוח הגרגוריאני. ראש חודש הוא מועד המצוין בתחילת כל חודש בלוח העברי ומסומן על ידי מולד הלבנה"

msgid "MEMO:Rosh Chodesh Adar I"
msgstr "תחילת חודש אדר א' (בשנים מעוברות) בלוח העברי. אדר א' הוא החודש ה-6 בשנה העברית האזרחית והחודש ה-12 בשנה העברית המקראית. יש בו 30 ימים, הוא חל רק בשנים מעוברות ומקביל לפברואר או מרץ בלוח הגרגוריאני. ראש חודש הוא מועד המצוין בתחילת כל חודש בלוח העברי ומסומן על ידי מולד הלבנה"

msgid "MEMO:Rosh Chodesh Adar II"
msgstr "תחילת חודש אדר ב' (בשנים מעוברות) בלוח העברי. אדר ב', נקרא לעיתים “אדר שני”, הוא החודש ה-7 בשנה העברית האזרחית והחודש ה-13 בשנה העברית. יש בו 29 ימים, הוא חל רק בשנים מעוברות ומקביל לפברואר או מרץ בלוח הגרגוריאני. ראש חודש הוא מועד המצוין בתחילת כל חודש בלוח העברי ומסומן על ידי מולד הלבנה"

msgid "MEMO:Rosh Hashana"
msgstr "ראש השנה היהודי"

msgid "MEMO:Rosh Hashana LaBehemot"
msgstr "ראש השנה למעשר בהמה"

msgid "MEMO:Shabbat Chazon"
msgstr "שבת חזון (שבת הנבואה). השבת שלפני תשעה באב"

msgid "MEMO:Shabbat HaChodesh"
msgstr "שבת החודש. השבת שלפני ראש חודש ניסן. נקראת כהכנה לפסח"

msgid "MEMO:Shabbat HaGadol"
msgstr "שבת הגדול. השבת שלפני חג הפסח"

msgid "MEMO:Shabbat Machar Chodesh"
msgstr "שבת מחר חודש. כאשר שבת חלה ביום שלפני ראש חודש"

msgid "MEMO:Shabbat Mevarchim Chodesh"
msgstr "שבת מברכים. השבת שקודמת לראש חודש, בה הקהל מברך את החודש החדש שבפתח"

msgid "MEMO:Shabbat Nachamu"
msgstr "שבת נחמו. השבת שלאחר תשעה באב (שבת של נחמה). הראשונה מבין שבע שבתות המובילות לראש השנה. נקראת על שם ההפטרה (ישעיהו מ') הפותחת בפסוק “נַחֲמוּ נַחֲמוּ, עַמִּי”"

msgid "MEMO:Shabbat Parah"
msgstr "שבת פרה (אדומה). השבת שלפני שבת החודש, כהכנה לפסח"

msgid "MEMO:Shabbat Rosh Chodesh"
msgstr "שבת ראש חודש. כאשר שבת חלה בראש חודש"

msgid "MEMO:Shabbat Shekalim"
msgstr "שבת שקלים. השבת שלפני ראש חודש אדר. נקראת כהכנה לפורים"

msgid "MEMO:Shabbat Shirah"
msgstr "שבת שירה. השבת הכוללת את פרשת בשלח (ושירת הים)"

msgid "MEMO:Shabbat Shuva"
msgstr "שבת שובה. השבת שחלה במהלך עשרת ימי תשובה בין ראש השנה ליום כיפור"

msgid "MEMO:Shabbat Zachor"
msgstr "שבת זכור. השבת שלפני פורים"

msgid "MEMO:Shavuot"
msgstr "חג השבועות. מציין את מתן תורה בהר סיני"

msgid "MEMO:Shmini Atzeret"
msgstr "שמיני עצרת. חל מיד לאחר סוכות; בתפוצות נחגג כחג נפרד ובישראל משולב עם שמחת תורה"

msgid "MEMO:Shushan Purim"
msgstr "פורים הנחגג בירושלים ובערים מוקxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxים ובערים מוקפות חומה (בשנה מעוברת)"

msgid "MEMO:Sigd"
msgstr "הסיגד, חג של יהדות אתיופיה החל 50 יום לאחר יום הכיפורים"

msgid "MEMO:Simchat Torah"
msgstr "שמחת תורה. חגיגה המציינת את סיום המחזור השנתי של קריאת התורה בציבור, ותחילתו של מחזור חדש"

msgid "MEMO:Sukkot"
msgstr "חג הסוכות. החג שנמשך שבעה ימים הוא אחד משלושת הרגלים"

msgid "MEMO:Ta'anit Bechorot"
msgstr "תענית בכורות"

msgid "MEMO:Ta'anit Esther"
msgstr "תענית אסתר"

msgid "MEMO:Tish'a B'Av"
msgstr "תשעה באב. צום המציין את חורבן שני בתי המקדש"

msgid "MEMO:Tu B'Av"
msgstr "ט״ו באב, חג האהבה היהודי. מצוין בט״ו בחודש אב העברי"

msgid "MEMO:Tu BiShvat"
msgstr "ראש השנה לאילנות. ט״ו בשבט הוא אחד מארבעת “ראשי השנה” המוזכרים במשנה"

msgid "MEMO:Tzom Gedaliah"
msgstr "צום גדליה (צום החודש השביעי). מציין את רצח המושל היהודי של יהודה"

msgid "MEMO:Tzom Tammuz"
msgstr "צום י״ז בתמוז. צום המציין את הבקעת חומות ירושלים לפני חורבן בית המקדש השני"

msgid "MEMO:Yitzhak Rabin Memorial Day"
msgstr "יום הזיכרון ליצחק רבין. מציין את חייו של ראש ממשלת ישראל יצחק רבין"

msgid "MEMO:Yom HaAliyah"
msgstr "מציין את העלייה למדינת ישראל"

msgid "MEMO:Yom HaAliyah School Observance"
msgstr "יום העלייה כפי שמצוין בבתי הספר בישראל"

msgid "MEMO:Yom HaAtzma'ut"
msgstr "יום העצמאות. מציין את הכרזת העצמאות של ישראל בשנת 1948. למרות שיום העצמאות מצוין בדרך כלל בה' באייר, הוא עשוי להיות מוקדם או להידחות אם קיום החג (או יום הזיכרון שתמיד קודם לו) יתנגש עם השבת"

msgid "MEMO:Yom HaShoah"
msgstr "יום הזיכרון לשואה ולגבורה"

msgid "MEMO:Yom HaZikaron"
msgstr "יום הזיכרון לחללי מערכות ישראל. זוכר את אלו שנפלו במלחמת העצמאות ובמלחמות ישראל האחרות. השם המלא של החג הוא “יום הזיכרון לחללי מערכות ישראל ולנפגעי פעולות האיבה״. למרות שיום הזיכרון מצוין בדרך כלל בד' באייר, הוא עשוי להיות מוקדם או להידחות אם קיום היום (או יום העצמאות שבא תמיד אחריו) יתנגש עם השבת"

msgid "MEMO:Yom Kippur"
msgstr "יום הכיפורים. היום הקדוש ביותר בשנה ביהדות, המצוין באופן מסורתי בצום של 25 שעות ותפילה אינטנסיבית"

msgid "MEMO:Yom Kippur Katan"
msgstr "יום כיפור קטן. יום כפרה החל מדי חודש ביום שלפני כל ראש חודש"

msgid "MEMO:Yom Yerushalayim"
msgstr "יום ירושלים. מציין את איחודה מחדש של ירושלים בשנת 1967"
