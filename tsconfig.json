{
  "compilerOptions": {
    "types": [],
    "esModuleInterop": true,
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "rootDir": "./src",
    "outDir": "./dist/esm"
  },
  "include": ["src/**/*"],
  "exclude": ["dist"]
}
