{
  "compilerOptions": {
    "types": [],
    "esModuleInterop": true,
    "target": "es2023",
    // `dom` supplies URL; `esnext.temporal` supplies the Temporal namespace
    // that the @hebcal/core and @hebcal/noaa declarations reference.
    "lib": ["es2023", "dom", "esnext.temporal"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    "rootDir": "./src",
    "outDir": "./dist/esm"
  },
  "include": ["src/**/*"],
  "exclude": ["dist"]
}
